@model List<UserViewModel>

<div class="container mt-4">

    @if (TempData["AvisoAdmin"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>
            <div><strong>Ação Bloqueada:</strong> @TempData["AvisoAdmin"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SucessoAdmin"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-4 text-success me-3"></i>
            <div><strong>Sucesso:</strong> @TempData["SucessoAdmin"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white px-3 py-2 rounded-pill shadow-sm d-inline-flex">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
                    <i class="bi bi-house-door me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Gerenciar Usuários</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <h2 class="mb-0 fw-bold text-dark">
            <i class="bi bi-people-fill text-primary me-2"></i>Gerenciar Usuários
        </h2>

        <form method="get" class="d-flex">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Buscar por nome..." value="@Context.Request.Query["search"]" />
                <button type="submit" class="btn btn-primary px-4 fw-medium">Buscar</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white shadow-sm rounded-4 mt-4 border-0">
            <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3 fw-bold text-dark">Nenhum usuário encontrado</h4>
            <p class="text-muted">Não encontramos resultados para a sua busca.</p>
            <a asp-action="Index" class="btn btn-outline-primary mt-2 rounded-pill px-4">Limpar Filtro</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4 fw-medium border-0">Usuário</th>
                            <th class="fw-medium border-0">E-mail</th>
                            <th class="fw-medium border-0">Nível de Acesso</th>
                            <th class="pe-4 border-0 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (user.IsAdmin)
                                        {
                                            <i class="bi bi-shield-fill-check text-success fs-4 me-3"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle text-secondary fs-4 me-3"></i>
                                        }
                                        <div>
                                            <span class="d-block fw-bold text-dark">
                                                @(string.IsNullOrEmpty(user.FirstName) ? "Usuário Sem Nome" : $"{user.FirstName} {user.LastName}")
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-muted">
                                    @user.Email
                                </td>

                                <td>
                                    <span class="badge rounded-pill @(user.IsAdmin ? "bg-success" : "bg-secondary text-white") px-3 py-2 fw-medium shadow-sm">
                                        @(user.IsAdmin ? "Administrador" : "Cliente")
                                    </span>
                                </td>

                                <td class="pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="ToggleAdmin"
                                           asp-route-id="@user.Id"
                                           class="btn @(user.IsAdmin ? "btn-outline-danger" : "btn-outline-success") rounded-pill fw-medium btn-sm d-flex align-items-center">
                                            @if (user.IsAdmin)
                                            {
                                                <span><i class="bi bi-person-down me-1"></i>Remover Admin</span>
                                            }
                                            else
                                            {
                                                <span><i class="bi bi-person-up me-1"></i>Tornar Admin</span>
                                            }
                                        </a>

                                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('ATENÇÃO: Deseja realmente excluir permanentemente este usuário e todos os dados vinculados a ele? Esta ação não pode ser desfeita.');"
                                              class="m-0">
                                            <button type="submit" class="btn btn-outline-secondary rounded-pill btn-sm px-3 h-100" title="Excluir Usuário">
                                                <i class="bi bi-trash3-fill text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
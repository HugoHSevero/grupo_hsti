@model Chamado

<div class="container mt-4 mb-5">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white px-3 py-2 rounded-pill shadow-sm d-inline-flex">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
                    <i class="bi bi-house-door me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item text-secondary">
                <a asp-controller="Chamados" asp-action="Index" class="text-decoration-none text-secondary">
                    Chamados
                </a>
            </li>
            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Novo Chamado</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-plus-circle-fill text-primary me-2"></i>Abrir Chamado
        </h2>
        <p class="text-muted">Preencha os detalhes abaixo para criar uma nova solicitação de suporte.</p>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Titulo" class="form-label fw-medium text-dark">
                        <i class="bi bi-fonts text-muted me-1"></i> Título da Solicitação
                    </label>
                    <input asp-for="Titulo" class="form-control form-control-lg bg-light border-0" placeholder="Ex: Computador não liga..." required /> />
                    <span asp-validation-for="Titulo" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descricao" class="form-label fw-medium text-dark">
                        <i class="bi bi-justify-left text-muted me-1"></i> Detalhes do Problema
                    </label>
                    <textarea asp-for="Descricao" class="form-control bg-light border-0" rows="5" placeholder="Descreva com o máximo de detalhes..." required></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label asp-for="Categoria" class="form-label fw-medium text-dark">
                            <i class="bi bi-tag text-muted me-1"></i> Categoria
                        </label>
                        <select asp-for="Categoria" class="form-select form-select-lg bg-light border-0" asp-items="Html.GetEnumSelectList<CategoriaChamado>()" required>
                            <option value="">Selecione uma categoria...</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Prioridade" class="form-label fw-medium text-dark">
                            <i class="bi bi-exclamation-triangle text-muted me-1"></i> Prioridade
                        </label>
                        <select asp-for="Prioridade" class="form-select form-select-lg bg-light border-0" asp-items="Html.GetEnumSelectList<PrioridadeChamado>()" required>
                            <option value="">Selecione o nível...</option>
                        </select>
                        <span asp-validation-for="Prioridade" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted">

                <div class="d-flex flex-column flex-md-row gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-medium">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-send-fill me-2"></i> Enviar Chamado
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
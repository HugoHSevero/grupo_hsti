@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="d-flex justify-content-center align-items-center py-5" style="min-height: 75vh;">
    <div class="card shadow-sm border-0 rounded-4 w-100" style="max-width: 450px;">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-5">
                <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3.5rem;"></i>
                <h2 class="fw-bold text-dark mt-2">Bem-vindo de volta</h2>
                <p class="text-muted small">Faça login para acessar o portal de suporte.</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 text-center small" role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Email" type="email" class="form-control bg-light border-0" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                    <label>E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="input-group mb-4">
                    <div class="form-floating flex-grow-1">
                        <input asp-for="Input.Password" type="password" id="campoSenhaLogin" class="form-control bg-light border-0" autocomplete="current-password" aria-required="true" placeholder="Senha" />
                        <label>Senha</label>
                    </div>
                    <button type="button" class="btn bg-light text-muted border-0 px-3" onclick="alternarSenha('campoSenhaLogin', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small d-block mb-3" style="margin-top: -15px;"></span>

                <div class="form-check mb-4">
                    <input class="form-check-input shadow-sm" asp-for="Input.RememberMe" />
                    <label class="form-check-label text-muted small" asp-for="Input.RememberMe">
                        Lembrar de mim
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill fw-bold shadow-sm mt-2">
                    Entrar
                </button>

                <div class="text-center mt-5">
                    <p class="text-muted small mb-0">
                        Ainda não tem uma conta?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary text-decoration-none fw-bold">Crie uma aqui</a>
                    </p>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function alternarSenha(inputId, botao) {
            var input = document.getElementById(inputId);

            if (input.type === "password") {
                input.type = "text";
                // Coloca o ícone de olho cortado
                botao.innerHTML = '<i class="bi bi-eye-slash"></i>';
            } else {
                input.type = "password";
                // Volta para o ícone de olho normal
                botao.innerHTML = '<i class="bi bi-eye"></i>';
            }
        }
    </script>
}
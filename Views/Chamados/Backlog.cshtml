@using System.Security.Claims
@model List<Chamado>

@{
    // Pega o status atual da URL para sabermos qual botão de filtro pintar de azul
    var currentStatus = Context.Request.Query["status"].ToString();
}

<div class="container mt-4">

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white px-3 py-2 rounded-pill shadow-sm d-inline-flex">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
                    <i class="bi bi-house-door me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Backlog de Chamados</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <h2 class="mb-0 fw-bold text-dark">
            <i class="bi bi-card-checklist text-primary me-2"></i>Backlog de Chamados
        </h2>

        <form method="get" class="d-flex">
            @if (Context.Request.Query.ContainsKey("status"))
            {
                <input type="hidden" name="status" value="@Context.Request.Query["status"]" />
            }
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Buscar título ou usuário..." value="@ViewData["CurrentSearch"]" />
                <button type="submit" class="btn btn-primary px-4 fw-medium">Buscar</button>
            </div>
        </form>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Backlog" asp-route-search="@ViewData["CurrentSearch"]"
           class="btn rounded-pill px-4 shadow-sm fw-medium @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "bg-white text-secondary border-0")">
            Todos
        </a>

        <a asp-action="Backlog" asp-route-status="Aberto" asp-route-search="@ViewData["CurrentSearch"]"
           class="btn rounded-pill px-4 shadow-sm fw-medium @(currentStatus == "Aberto" ? "btn-primary" : "bg-white text-secondary border-0")">
            Abertos
        </a>

        <a asp-action="Backlog" asp-route-status="EmAndamento" asp-route-search="@ViewData["CurrentSearch"]"
           class="btn rounded-pill px-4 shadow-sm fw-medium @(currentStatus == "EmAndamento" ? "btn-primary" : "bg-white text-secondary border-0")">
            Em andamento
        </a>

        <a asp-action="Backlog" asp-route-status="Concluido" asp-route-search="@ViewData["CurrentSearch"]"
           class="btn rounded-pill px-4 shadow-sm fw-medium @(currentStatus == "Concluido" ? "btn-primary" : "bg-white text-secondary border-0")">
            Concluídos
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white shadow-sm rounded-4 border-0">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3 fw-bold text-dark">Nenhum chamado por aqui</h4>
            <p class="text-muted">Não há chamados para o filtro selecionado no momento.</p>
            <a asp-action="Backlog" class="btn btn-outline-primary mt-2 rounded-pill px-4">Ver todos os chamados</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4 fw-medium border-0">#</th>
                            <th class="fw-medium border-0">Título</th>
                            <th class="fw-medium border-0">Status</th>
                            <th class="fw-medium border-0">Categoria</th>
                            <th class="fw-medium border-0">Usuário</th>
                            <th class="fw-medium border-0">Data</th>
                            <th class="pe-4 border-0 text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted fw-medium">#@item.Id</td>
                                <td class="fw-bold text-dark">@item.Titulo</td>

                                <td>
                                    <span class="badge rounded-pill px-3 py-2 shadow-sm
                                        @(item.Status == StatusChamado.Aberto ? "bg-secondary text-white" :
                                            item.Status == StatusChamado.EmAndamento ? "bg-warning text-dark" :
                                            "bg-success text-white")">
                                        @Html.DisplayFor(m => item.Status)
                                    </span>
                                </td>

                                <td class="text-secondary">
                                    <i class="bi bi-tag text-muted me-1"></i> @Html.DisplayFor(m => item.Categoria)
                                </td>

                                <td class="text-secondary">
                                    <i class="bi bi-person text-muted me-1"></i>
                                    @(item.Usuario != null && !string.IsNullOrEmpty(item.Usuario.FirstName)
                                        ? $"{item.Usuario.FirstName} {item.Usuario.LastName}"
                                        : (item.Usuario?.Email ?? "Desconhecido"))
                                </td>

                                <td class="text-secondary">@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>

                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium">
                                        <i class="bi bi-eye me-1"></i>Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>